<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <!-- High-res rendered glass media player (Vinyl, waveform, progress bar, track title) -->
    <ImageView
        android:id="@+id/widget_music_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Glass Music Player" />

    <!-- Interactive Media Control Buttons Overlay -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_music_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_glass_circle_button"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_music_prev"
            android:contentDescription="Previous Track" />

        <ImageButton
            android:id="@+id/btn_music_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_glass_pill"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_music_pause"
            android:contentDescription="Play or Pause" />

        <ImageButton
            android:id="@+id/btn_music_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_glass_circle_button"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_music_next"
            android:contentDescription="Next Track" />
    </LinearLayout>

</FrameLayout>
