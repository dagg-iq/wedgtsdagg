<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_music"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NOW PLAYING • GLASS MUSIC"
            android:textColor="#B3D18CFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="HI-RES"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content: Disc Art & Track Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/music_album_art"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_music_disc"
            android:contentDescription="Album Art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/music_track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Midnight City"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/music_artist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="M83 • Glass Edition"
                android:textColor="#CCECEFF1"
                android:textSize="12sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/music_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2:14 / 4:03"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btn_music_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_circle_button"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_music_prev"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/btn_music_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_glass_pill"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_music_pause"
            android:contentDescription="Play/Pause" />

        <ImageButton
            android:id="@+id/btn_music_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_circle_button"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_music_next"
            android:contentDescription="Next" />
    </LinearLayout>

</LinearLayout>
